# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend -> API Keys
RESEND_API_KEY=
REPORT_EMAIL_TO=you@example.com
# Optional. Without a verified domain, Resend only lets onboarding@resend.dev send to your own signup email.
RESEND_FROM=MF Tracker <onboarding@resend.dev>

# newsdata.io -> Dashboard -> API key
NEWSDATA_API_KEY=

# Any long random string. Vercel sends it to cron routes automatically.
CRON_SECRET=
